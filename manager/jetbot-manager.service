[Unit]
Description=JetBot manager: starts and stops the robot software and manages maps (localhost only, token protected)
Documentation=file:@INSTALL_DIR@/README.md
After=network.target jetbot-firewall.service
Requires=jetbot-firewall.service

[Service]
Type=simple
User=@USER@
Environment=HOME=@HOME@
ExecStart=/usr/bin/python3 @INSTALL_DIR@/jetbot_manager.py
Restart=on-failure
RestartSec=5
TimeoutStopSec=45

[Install]
WantedBy=multi-user.target
