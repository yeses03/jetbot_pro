[Unit]
Description=JetBot: block outside access to rosbridge (TCP 9090), which has no authentication
Documentation=file:@INSTALL_DIR@/README.md
After=network-pre.target
Before=jetbot-manager.service

[Service]
Type=oneshot
RemainAfterExit=yes
ExecStart=/bin/sh -c 'iptables -C INPUT -p tcp -m tcp --dport 9090 ! -i lo -j DROP 2>/dev/null || iptables -I INPUT -p tcp -m tcp --dport 9090 ! -i lo -j DROP'
ExecStart=/bin/sh -c 'if command -v ip6tables >/dev/null 2>&1; then ip6tables -C INPUT -p tcp -m tcp --dport 9090 ! -i lo -j DROP 2>/dev/null || ip6tables -I INPUT -p tcp -m tcp --dport 9090 ! -i lo -j DROP || true; fi'
ExecStop=/bin/sh -c 'iptables -D INPUT -p tcp -m tcp --dport 9090 ! -i lo -j DROP 2>/dev/null || true'

[Install]
WantedBy=multi-user.target
