<?xml version="1.0"?>
<!-- Localization only: chassis, LiDAR, map_server and AMCL. No move_base, no camera, no GMapping.
     The robot must start on the mapping start tape (map origin, facing the fridge, yaw 0). -->
<launch>
  <!-- Odometry distance scale, sent to the chassis firmware at startup. Default 1.0 = unchanged.
       Measured 2026-11-02: wheel odometry reads about 0.76 of the true distance, so try 1.3. -->
  <arg name="linear_correction" default="1.0"/>
  <arg name="angular_correction" default="1.0"/>
  <include file="$(find jetbot_pro)/launch/jetbot.launch" />
  <param name="/jetbot/linear_correction" value="$(arg linear_correction)"/>
  <param name="/jetbot/angular_correction" value="$(arg angular_correction)"/>
  <include file="$(find jetbot_pro)/launch/lidar.launch" />

  <arg name="map_file" default="$(env HOME)/maps/livingroom_20261102_0830_cropped.yaml"/>
  <node name="map_server" pkg="map_server" type="map_server" args="$(arg map_file)" />

  <!-- AMCL update thresholds and beam count. Defaults equal the values in amcl.launch (unchanged behaviour). -->
  <arg name="amcl_update_min_d" default="0.2"/>
  <arg name="amcl_update_min_a" default="0.5"/>
  <arg name="amcl_laser_max_beams" default="30"/>
  <!-- Laser model weights (defaults = amcl.launch values) and the initial pose AMCL starts from (map frame). -->
  <arg name="amcl_z_hit" default="0.5"/>
  <arg name="amcl_z_rand" default="0.5"/>
  <!-- Odometry motion noise and laser sharpness (defaults = amcl.launch values). Lower noise = trust the odometry more. -->
  <arg name="amcl_alpha1" default="0.2"/>
  <arg name="amcl_alpha2" default="0.2"/>
  <arg name="amcl_alpha3" default="0.8"/>
  <arg name="amcl_alpha4" default="0.2"/>
  <arg name="amcl_sigma_hit" default="0.2"/>
  <arg name="initial_x" default="0.0"/>
  <arg name="initial_y" default="0.0"/>
  <arg name="initial_a" default="0.0"/>
  <include file="$(find jetbot_pro)/launch/amcl.launch" />
  <param name="/amcl/update_min_d" value="$(arg amcl_update_min_d)"/>
  <param name="/amcl/update_min_a" value="$(arg amcl_update_min_a)"/>
  <param name="/amcl/laser_max_beams" value="$(arg amcl_laser_max_beams)"/>
  <param name="/amcl/laser_z_hit" value="$(arg amcl_z_hit)"/>
  <param name="/amcl/laser_z_rand" value="$(arg amcl_z_rand)"/>
  <param name="/amcl/odom_alpha1" value="$(arg amcl_alpha1)"/>
  <param name="/amcl/odom_alpha2" value="$(arg amcl_alpha2)"/>
  <param name="/amcl/odom_alpha3" value="$(arg amcl_alpha3)"/>
  <param name="/amcl/odom_alpha4" value="$(arg amcl_alpha4)"/>
  <param name="/amcl/laser_sigma_hit" value="$(arg amcl_sigma_hit)"/>
  <param name="/amcl/initial_pose_x" value="$(arg initial_x)"/>
  <param name="/amcl/initial_pose_y" value="$(arg initial_y)"/>
  <param name="/amcl/initial_pose_a" value="$(arg initial_a)"/>
</launch>
