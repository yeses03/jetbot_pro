<?xml version="1.0"?>
<!-- Link for the desktop dashboard (gui/). WARNING: rosbridge has NO authentication, and in rosbridge_server 0.11.16 the
     `address` argument does NOT restrict where it listens (verified on the robot: it listened on 0.0.0.0:9090 even with
     address:=127.0.0.1). Anyone on the network could publish /cmd_vel. Before starting it, block outside access on the Jetson:
         sudo iptables -I INPUT -p tcp --dport 9090 ! -i lo -j DROP
     (not persistent across reboots), confirm from another machine that `nc -vz <jetson-ip> 9090` FAILS, and then use an SSH tunnel:
         ssh -N -L 9090:127.0.0.1:9090 nvidia@<jetson-ip>      and point the GUI at host 127.0.0.1
     Needs the package ros-melodic-rosbridge-suite. -->
<launch>
  <arg name="address" default="127.0.0.1"/>
  <arg name="port" default="9090"/>
  <include file="$(find rosbridge_server)/launch/rosbridge_websocket.launch">
    <arg name="address" value="$(arg address)"/>
    <arg name="port" value="$(arg port)"/>
  </include>
</launch>
